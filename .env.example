# =============================================================================
# Akomapa Academy — Environment variables
# =============================================================================
# Copy this file to `.env.local` for local development and fill in real values.
# These names are authoritative (they match what the code actually reads).
# NEXT_PUBLIC_* vars are inlined at build time — changing them requires a rebuild.
# Never commit real secrets. `.env*` files are gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# -----------------------------------------------------------------------------
# App runtime connection. On serverless use the pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/akomapa?schema=public"
# Direct (non-pooler) connection used by Prisma CLI for migrations.
# Falls back to DATABASE_URL if unset. Use the direct URL when DATABASE_URL is pooled.
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/akomapa?schema=public"

# -----------------------------------------------------------------------------
# Clerk (authentication)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Svix signing secret for the /api/webhooks/clerk endpoint.
CLERK_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Mux (video)
# -----------------------------------------------------------------------------
MUX_TOKEN_ID=...
MUX_TOKEN_SECRET=...

# -----------------------------------------------------------------------------
# UploadThing (file uploads) — v7 uses a single base64 token
# -----------------------------------------------------------------------------
UPLOADTHING_TOKEN=...

# -----------------------------------------------------------------------------
# Stripe (payments)
# -----------------------------------------------------------------------------
# Secret key. NOTE: the code reads STRIPE_API_KEY (not STRIPE_SECRET_KEY).
STRIPE_API_KEY=sk_test_...
# Signing secret for the /api/webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------
# Absolute origin for this environment (used for Stripe checkout redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical/OG base for SEO. Set per environment; else falls back to the Vercel
# production URL, then NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Server-only Clerk user id treated as ADMIN (backward-compat bootstrap only;
# prefer the User.role column). NOTE: code reads TEACHER_ID (not NEXT_PUBLIC_TEACHER_ID).
TEACHER_ID=user_...
