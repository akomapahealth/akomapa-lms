# Vendored agent tooling installed into .github by `npx impeccable install`.
# Third-party skill/agent/hook payloads, not repository CI configuration.
/.github/agents/
/.github/hooks/
/.github/skills/

# Internal planning docs (DO NOT commit — agents should not stage these files).
# Committed exceptions: shared agent workflow guidance and architecture
# decision records, which are sources of truth for every contributor.
/docs/*
!/docs/agents/
!/docs/agents/**
!/docs/adr/
!/docs/adr/**
!/docs/policies/
!/docs/policies/**
!/docs/ai/
!/docs/ai/**
!/docs/release/
!/docs/release/**
# The permission matrix: the authorization rules every contributor and agent
# must implement against, asserted by tests/unit/auth/policy.test.ts.
!/docs/permission-matrix.md
# Phase specifications: the historical record the release matrix audits
# against. Committed so that audit is reproducible by anyone.
!/docs/phase-1.md
!/docs/phase-2.md
!/docs/phase-3.md
!/docs/phase-4.md
!/docs/phase-5.md
