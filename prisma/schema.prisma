// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  /// Clerk user id
  id        String   @id
  email     String?  @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  role      UserRole @default(STUDENT)

  // Faculty-specific fields
  bio            String? @db.Text
  title          String? // e.g., "Dr.", "Prof."
  specialization String?

  courses       Course[]
  purchases     Purchase[]
  progress      UserProgress[]
  stripeAccount StripCustomer?
  enrollments   Enrollment[]
  quizAttempts  QuizAttempt[]

  // Forum relations
  forumPosts    ForumPost[]
  forumComments ForumComment[]
  postLikes     PostLike[]
  commentLikes  CommentLike[]

  // Faculty relation
  assignedModules Module[] @relation("ModuleFaculty")

  // Phase 5: Gamification, Journals, Certificates
  badges            UserBadge[]
  learningStreak    LearningStreak?
  journalEntries    JournalEntry[]
  caseStudyAttempts CaseStudyAttempt[]
  certificates      Certificate[]
  settings          UserSettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id          String  @id @default(uuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  title       String  @db.Text
  description String? @db.Text
  imageUrl    String? @db.Text
  price       Float?
  isPublished Boolean @default(false)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  modules        Module[]
  attachments    Attachment[]
  purchases      Purchase[]
  enrollments    Enrollment[]
  quizzes        Quiz[]
  forumPosts     ForumPost[]
  journalEntries JournalEntry[]
  certificates   Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model Category {
  id      String   @id @default(uuid())
  name    String   @unique
  courses Course[]
}

model Module {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text
  imageUrl    String? @db.Text
  position    Int
  isPublished Boolean @default(false)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  facultyId String?
  faculty   User?   @relation("ModuleFaculty", fields: [facultyId], references: [id], onDelete: Restrict)

  reflectionPrompt String? @db.Text

  topics         Topic[]
  quizzes        Quiz[]
  journalEntries JournalEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique per parent (#51): two rows at one position made the order
  // non-deterministic. Reorders move rows in two phases so this always holds.
  @@unique([courseId, position])
}

model Attachment {
  id   String @id @default(uuid())
  name String
  url  String @db.Text

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model Topic {
  id          String           @id @default(uuid())
  title       String
  description String?          @db.Text
  videoUrl    String?          @db.Text
  textContent String?          @db.Text
  contentType TopicContentType @default(VIDEO)
  position    Int
  isPublished Boolean          @default(false)
  isFree      Boolean          @default(false)

  muxData   MuxData?
  caseStudy CaseStudy?

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  userProgress UserProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique per parent (#51): two rows at one position made the order
  // non-deterministic. Reorders move rows in two phases so this always holds.
  @@unique([moduleId, position])
  @@map("Chapter")
}

model MuxData {
  id         String @id @default(uuid())
  playbackId String
  assetId    String

  topicId String @unique @map("chapterId")
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  topicId String @map("chapterId")
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Restrict)

  isCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, topicId], map: "UserProgress_userId_chapterId_key")
  @@index([topicId], map: "UserProgress_chapterId_idx")
}

model Purchase {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  @@unique([userId, courseId])
  @@index([courseId])
}

model Enrollment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

model StripCustomer {
  id               String @default(uuid())
  userId           String @unique
  user             User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  stripeCustomerId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Quiz System ───

model Quiz {
  id               String   @id @default(uuid())
  title            String
  type             QuizType
  timeLimitMinutes Int?
  passingScore     Float    @default(70)
  isPublished      Boolean  @default(false)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  questions Question[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([moduleId])
}

model Question {
  id       String @id @default(uuid())
  text     String @db.Text
  position Int
  points   Int    @default(1)

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  options QuestionOption[]
  answers QuizAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique per parent (#51): two rows at one position made the order
  // non-deterministic. Reorders move rows in two phases so this always holds.
  @@unique([quizId, position])
}

model QuestionOption {
  id        String  @id @default(uuid())
  text      String
  isCorrect Boolean @default(false)
  position  Int

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedIn QuizAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique per parent (#51): two rows at one position made the order
  // non-deterministic. Reorders move rows in two phases so this always holds.
  @@unique([questionId, position])
}

model QuizAttempt {
  id          String    @id @default(uuid())
  score       Float?
  totalPoints Int?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Restrict)

  answers QuizAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([quizId])
}

model QuizAnswer {
  id String @id @default(uuid())

  attemptId String
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attemptId])
  @@index([questionId])
}

// ─── Forum / Community ───

model ForumCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String? @db.Text
  color       String  @default("#0097b2")
  position    Int     @default(0)

  posts ForumPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ForumPost {
  id       String  @id @default(uuid())
  title    String
  content  String  @db.Text
  isPinned Boolean @default(false)
  isLocked Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  categoryId String
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  comments ForumComment[]
  likes    PostLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([courseId])
  @@index([userId])
}

model ForumComment {
  id      String @id @default(uuid())
  content String @db.Text

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentId String?
  parent   ForumComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ForumComment[] @relation("CommentReplies")

  likes CommentLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([parentId])
  @@index([userId])
}

model PostLike {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model CommentLike {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  commentId String
  comment   ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

// ─── Phase 5: Gamification ───

model Badge {
  id          String    @id @default(uuid())
  name        String    @unique
  description String
  imageUrl    String?   @db.Text
  type        BadgeType
  criteria    Json

  userBadges UserBadge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserBadge {
  id       String   @id @default(uuid())
  earnedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  badgeId String
  badge   Badge  @relation(fields: [badgeId], references: [id], onDelete: Restrict)

  @@unique([userId, badgeId])
  @@index([userId])
}

model LearningStreak {
  id               String    @id @default(uuid())
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  updatedAt DateTime @updatedAt
}

// ─── Phase 5: Reflection Journal ───

model JournalEntry {
  id        String  @id @default(uuid())
  title     String
  content   String  @db.Text
  isPrivate Boolean @default(true)

  prompt String? @db.Text

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([moduleId])
  @@index([courseId])
}

// ─── Phase 5: Case Study Simulator ───

model CaseStudy {
  id          String @id @default(uuid())
  title       String
  description String @db.Text
  scenario    Json

  topicId String @unique
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  attempts CaseStudyAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CaseStudyAttempt {
  id        String  @id @default(uuid())
  choices   Json
  completed Boolean @default(false)

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([caseStudyId])
}

// ─── Phase 5: Certificates ───

model Certificate {
  id                String   @id @default(uuid())
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  pdfUrl String? @db.Text

  @@unique([userId, courseId])
  @@index([userId])
}

// ─── Phase 5: User Settings ───

model UserSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  theme                  ThemePreference @default(light)
  defaultJournalPrivacy  Boolean         @default(true)
  showProfileInCommunity Boolean         @default(true)
  emailOnBadgeEarned     Boolean         @default(true)
  emailOnForumReply      Boolean         @default(true)
  emailOnFacultyComment  Boolean         @default(true)

  updatedAt DateTime @updatedAt
}

// ─── Abuse controls (#46) ───

/// One rate-limit bucket: a GCRA "theoretical arrival time" per hashed key.
///
/// `key` is an HMAC of the policy, the dimension (user or IP), and the subject,
/// so neither a user id nor an IP address is stored in the clear. `tat` is the
/// time, in epoch milliseconds, at which the bucket would be full again.
/// `expiresAt` equals `tat`: past it, the row is indistinguishable from an absent
/// one and may be deleted. See lib/rate-limit and docs/security/rate-limits.md.
model RateLimitBucket {
  key       String   @id
  tat       BigInt
  /// Whether the most recent consume against this bucket was allowed. Written in
  /// the same statement as `tat` so one round trip returns the decision.
  allowed   Boolean
  expiresAt DateTime

  @@index([expiresAt])
}

// ─── Closed domain states (#50) ───
//
// Every finite set of persisted values is a PostgreSQL enum, so the database
// refuses a value outside it rather than storing one that every reader must
// remember to distrust. Application code takes its types and value lists from
// the generated client via lib/domain/states.ts; nothing else spells the values
// out. Values match what the columns held as text, so the conversion
// (migration 20261003010000_closed_domain_states) maps each one to itself and
// refuses to run on anything else.

/// Authorization role (ADR 0001). ADMIN implies FACULTY.
enum UserRole {
  STUDENT
  FACULTY
  ADMIN
}

/// How a Topic's main content is delivered.
enum TopicContentType {
  VIDEO
  TEXT
  INTERACTIVE
}

/// Course entitlement state (ADR 0002). Transitions: lib/domain/states.ts.
enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
}

/// A Quiz's role in a Course. PRE_TEST and POST_TEST form the growth measure.
enum QuizType {
  PRE_TEST
  POST_TEST
  MODULE_QUIZ
}

/// The category a Badge is awarded in; its rule lives in `Badge.criteria`.
enum BadgeType {
  COMPLETION
  STREAK
  COMMUNITY
  QUIZ_SCORE
  MILESTONE
}

/// A learner's colour scheme. Lowercase because next-themes uses these names.
enum ThemePreference {
  light
  dark
  system
}
